## Hero data for the given ids, in that order.
static func heroes_by_ids(ids: Array) -> Array:
	var out := []
	for id in ids:
		for d in heroes() + summon_heroes() + story_heroes():
			if d["id"] == id:
				out.append(d)
	return out


